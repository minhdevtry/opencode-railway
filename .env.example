# Copy thành .env (file .env đã nằm trong .gitignore) rồi điền giá trị thật.
# docker compose tự đọc .env cạnh docker-compose.warp.yml để nội suy ${...}.
#
# Proxy dân cư dạng SOCKS5 (danh sách, ngăn cách bằng dấu phẩy)
RESIDENTIAL_PROXIES="socks5://user:pass@host:port"
# Link đổi IP của proxy dân cư (ngăn cách bằng dấu phẩy). Đây là BÍ MẬT: key nằm trong URL.
RESIDENTIAL_REFRESH_URLS="https://<provider>/get.php?key=<API_KEY>&nhamang=random"
# Danh sách model cho chế độ auto (để trống = dùng pool mặc định)
AUTO_MODELS=""
